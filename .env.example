# Copy this file to ".env" and fill in your own keys. NEVER commit the real .env.

# --- Qloo (from the hackathon registration portal) ---
QLOO_API_KEY=
# Confirm the correct base URL from Qloo's hackathon docs and update src/qloo_client.py if needed
QLOO_BASE_URL=https://hackathon.api.qloo.com

# --- LLM reasoning engine ---
# One of: mock | gemini | anthropic | openai
LLM_PROVIDER=mock

# Fill in only the one matching LLM_PROVIDER above.
# Gemini has a free tier — good for keeping runtime cost at zero.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
